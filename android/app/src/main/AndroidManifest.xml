<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".VotifyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Votify">

        <!--
            Точка входа — только через activity-alias ниже (по одному на каждый вариант
            иконки). У самой MainActivity intent-фильтра нет: иначе на рабочем столе
            висели бы две иконки Votify, а переключение варианта не работало бы.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Votify" />

        <!-- Иконка «как сейчас» (по умолчанию включена). -->
        <activity-alias
            android:name=".VotifyLauncher.Current"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ч/Б: та же иконка без серой полосы. -->
        <activity-alias
            android:name=".VotifyLauncher.Bw"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bw"
            android:roundIcon="@mipmap/ic_launcher_bw"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Старый логотип в духе iOS 27: стекло, блик, светлая кромка. -->
        <activity-alias
            android:name=".VotifyLauncher.Glass"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glass"
            android:roundIcon="@mipmap/ic_launcher_glass"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Старый логотип как есть: чёрная плитка со светлым диском. -->
        <activity-alias
            android:name=".VotifyLauncher.Classic"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:roundIcon="@mipmap/ic_launcher_classic"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Своя картинка из галереи (картинку показывает само приложение и ярлык). -->
        <activity-alias
            android:name=".VotifyLauncher.Custom"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_custom"
            android:roundIcon="@mipmap/ic_launcher_custom"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Offline downloads: keeps running while the screen is off, shows % in the shade. -->
        <service
            android:name=".data.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Home Screen Widgets -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.votify.mobile.widget.ACTION_PLAY_PAUSE" />
                <action android:name="app.votify.mobile.widget.ACTION_NEXT" />
                <action android:name="app.votify.mobile.widget.ACTION_PREV" />
                <action android:name="app.votify.mobile.widget.ACTION_TOGGLE_FAVORITE" />
                <action android:name="app.votify.mobile.widget.ACTION_PLAY_INDEX" />
                <action android:name="app.votify.mobile.widget.ACTION_SHUFFLE" />
                <action android:name="app.votify.mobile.widget.ACTION_SET_REMIX" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.PlayerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_player_3x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_3x2_info" />
        </receiver>

        <receiver
            android:name=".widget.PlaylistWidgetProvider"
            android:exported="true"
            android:label="@string/widget_playlist_2x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_playlist_2x2_info" />
        </receiver>

        <receiver
            android:name=".widget.CompactPlayerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_4x1_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_compact_4x1_info" />
        </receiver>

        <receiver
            android:name=".widget.RemixWidgetProvider"
            android:exported="true"
            android:label="@string/widget_remix_2x1_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remix_launcher_2x1_info" />
        </receiver>

        <service
            android:name=".widget.PlaylistRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>
</manifest>
