<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_cover_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Track cover art -->
    <ImageView
        android:id="@+id/widget_item_cover"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_votify_logo" />

    <!-- Title and artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Название трека"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Исполнитель"
            android:textColor="#8AFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Currently playing indicator -->
    <ImageView
        android:id="@+id/widget_item_playing"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_widget_music"
        android:tint="#FF34C759"
        android:visibility="gone" />

</LinearLayout>
