<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Round cover art -->
    <ImageView
        android:id="@+id/widget_compact_cover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_cover_bg"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_votify_logo" />

    <!-- Title and artist stacked -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Не воспроизводится"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Votify"
            android:textColor="#8AFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_compact_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_round_dark"
            android:padding="6dp"
            android:src="@drawable/ic_widget_skip_previous" />

        <ImageView
            android:id="@+id/widget_compact_btn_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_button_play"
            android:padding="8dp"
            android:src="@drawable/ic_widget_play"
            android:tint="#FF111113" />

        <ImageView
            android:id="@+id/widget_compact_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_round_dark"
            android:padding="6dp"
            android:src="@drawable/ic_widget_skip_next" />
    </LinearLayout>

</LinearLayout>
