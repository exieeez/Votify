{
  "name": "votify",
  "version": "0.6.1",
  "description": "Votify - Material You Music Player",
  "author": "Votify Team",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron .",
    "configure:google": "node scripts/configure-google-oauth.js",
    "deploy:firestore-rules": "npx firebase-tools@15.26.0 deploy --only firestore:rules --project votify-f461a",
    "test": "node --test",
    "prebuild": "node scripts/prepare-firebase-config.js",
    "build": "electron-builder --linux AppImage deb rpm",
    "prebuild:appimage": "node scripts/prepare-firebase-config.js",
    "build:appimage": "electron-builder --linux AppImage",
    "prebuild:win": "node scripts/prepare-firebase-config.js",
    "build:win": "electron-builder --win nsis --x64",
    "postinstall": "node scripts/download-ytdlp.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.votify.music",
    "productName": "Votify",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "discord-presence.js",
      "google-oauth.js",
      "firebase-config.json",
      "preload.js",
      "server.js",
      "routes/**/*",
      "bin/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "bin/**"
    ],
    "linux": {
      "category": "AudioVideo",
      "icon": "src/icon.png",
      "maintainer": "Votify Team"
    },
    "win": {
      "target": "nsis",
      "icon": "src/icon.png"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "bcryptjs": "^3.0.3",
    "firebase": "12.16.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true,
    "@firebase/util@1.15.2": true,
    "protobufjs@7.6.5": true
  }
}
