{
  "name": "votify-server",
  "version": "0.7.0",
  "description": "Votify backend API server (mobile edition)",
  "author": "Votify Team",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "postinstall": "node scripts/download-ytdlp.js",
    "deploy:firestore-rules": "npx firebase-tools@15.26.0 deploy --only firestore:rules --project votify-f461a",
    "test": "node --test",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3"
  }
}
