rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPermanentAccount() {
      return isSignedIn() && request.auth.token.email is string;
    }

    function isColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidWorkshopTheme(theme) {
      return theme is map
        && theme.keys().hasAll([
          'primary',
          'background',
          'text',
          'cards',
          'borders',
          'focus',
          'mode',
          'backgroundPreset',
          'backgroundUrl',
          'cornerRadius',
          'uiTransparency',
          'backgroundBlur',
          'particles',
          'fontFamily'
        ])
        && theme.keys().hasOnly([
          'primary',
          'background',
          'text',
          'cards',
          'borders',
          'focus',
          'mode',
          'backgroundPreset',
          'backgroundUrl',
          'cornerRadius',
          'uiTransparency',
          'backgroundBlur',
          'particles',
          'fontFamily'
        ])
        && isColor(theme.primary)
        && isColor(theme.background)
        && isColor(theme.text)
        && isColor(theme.cards)
        && isColor(theme.borders)
        && isColor(theme.focus)
        && theme.mode in ['dark', 'light', 'system']
        && theme.backgroundPreset in [
          'default', 'grad-1', 'grad-2', 'grad-3', 'grad-4',
          'grad-5', 'grad-6', 'grad-7', 'grad-8', 'grad-9'
        ]
        && theme.backgroundUrl is string
        && theme.backgroundUrl.size() <= 2048
        && (theme.backgroundUrl == '' || theme.backgroundUrl.matches('^https://.+$'))
        && !theme.backgroundUrl.matches('^https://[^/]*@.*$')
        && theme.cornerRadius is int
        && theme.cornerRadius >= 0
        && theme.cornerRadius <= 24
        && theme.uiTransparency is int
        && theme.uiTransparency >= 10
        && theme.uiTransparency <= 100
        && theme.backgroundBlur is int
        && theme.backgroundBlur >= 0
        && theme.backgroundBlur <= 60
        && theme.particles in [
          'none', 'snow', 'rain', 'stars', 'dots', 'hearts',
          'fireflies', 'sakura', 'network'
        ]
        && theme.fontFamily in [
          'system', 'modern', 'serif', 'mono', 'hand', 'deco',
          'game', 'inter', 'roboto', 'helvetica', 'sf'
        ];
    }

    function isValidWorkshopDocument() {
      return request.resource.data.keys().hasAll([
          'title',
          'description',
          'ownerId',
          'authorName',
          'theme',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'ownerId',
          'authorName',
          'theme',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidWorkshopTheme(request.resource.data.theme);
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if isSignedIn() && request.auth.uid == userId;

      match /{document=**} {
        allow read, create, update, delete:
          if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /workshopThemes/{themeId} {
      allow read: if true;
      allow create: if isPermanentAccount() && isValidWorkshopDocument();
      allow update: if false;
      allow delete: if isPermanentAccount()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
